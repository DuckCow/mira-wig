{
  "name": "mira",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typegen": "next typegen",
    "pretypecheck": "npm run typegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:setup": "createdb -U $USER wig_platform_test 2>/dev/null || true && node --env-file=.env.test node_modules/prisma/build/index.js migrate deploy",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "make-admin": "tsx scripts/make-admin.ts",
    "payment:reconcile": "node --import tsx scripts/payment-reconcile.ts",
    "refund:worker:check": "node --import tsx scripts/refund-execution-worker.ts check",
    "refund:worker:health": "node --import tsx scripts/refund-execution-worker.ts health",
    "refund:worker:once": "node --import tsx scripts/refund-execution-worker.ts run-once",
    "refund:worker:rehearse": "node --import tsx scripts/refund-worker-deployment-rehearsal.ts",
    "refund:sandbox:preflight": "node --import tsx scripts/refund-sandbox-provider-free-preflight.ts",
    "refund:image:bundle": "node --import tsx scripts/build-refund-worker-bundles.mts",
    "refund:image:verify": "node --import tsx scripts/verify-refund-worker-image.mts",
    "refund:image:reproducibility": "node --import tsx scripts/verify-refund-worker-reproducibility.mts",
    "refund:ops:manual": "node --import tsx scripts/refund-operations.ts manual",
    "refund:ops:reconcile": "node --import tsx scripts/refund-operations.ts reconcile",
    "refund:ops:credential": "node --import tsx scripts/refund-operations.ts credential"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "7.0.0",
    "@auth/prisma-adapter": "^2.11.2",
    "@aws-sdk/client-s3": "^3.1064.0",
    "@aws-sdk/client-sesv2": "^3.1064.0",
    "@aws-sdk/s3-request-presigner": "^3.1064.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tosspayments/tosspayments-sdk": "^2.7.1",
    "next": "16.2.7",
    "next-auth": "^4.24.14",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.185.3",
    "dotenv": "^17.4.2",
    "esbuild": "0.28.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.7",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
