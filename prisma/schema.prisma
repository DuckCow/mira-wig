// ============================================================
// prisma/schema.prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// 인증
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  tryOns        TryOn[]
  orders        Order[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
}

enum UserRole {
  CUSTOMER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// 가발 카탈로그
// ============================================================

enum WigCategory {
  HAIR_LOSS
  FASHION
  COSPLAY
  TOPPER
  MEDICAL
}

model WigStyle {
  id            String      @id @default(cuid())
  name          String
  description   String?     @db.Text
  category      WigCategory
  tags          String[]
  coverImageKey String?
  imageKeys     String[]
  sortOrder     Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  variants      WigVariant[]
  tryOns        TryOn[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
}

model WigVariant {
  id         String  @id @default(cuid())
  wigStyleId String
  color      String
  colorHex   String?
  length     String
  curl       String
  price      Int
  stock      Int     @default(0)
  sku        String  @unique
  isActive   Boolean @default(true)

  wigStyle   WigStyle    @relation(fields: [wigStyleId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
}

// ============================================================
// AI 가상 피팅
// ============================================================

model TryOn {
  id                String      @id @default(cuid())
  userId            String
  wigStyleId        String
  wigVariantId      String?
  originalImageKey  String
  resultImageKey    String?
  status            TryOnStatus @default(PENDING)
  providerName      String?
  providerRequestId String?
  processingMs      Int?
  appliedOptions    Json?
  errorMessage      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wigStyle WigStyle @relation(fields: [wigStyleId], references: [id])
}

enum TryOnStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================================
// 장바구니 & 위시리스트
// ============================================================

model CartItem {
  id         String   @id @default(cuid())
  userId     String
  wigStyleId String
  variantId  String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  style   WigStyle   @relation(fields: [wigStyleId], references: [id])
  variant WigVariant @relation(fields: [variantId], references: [id])

  @@unique([userId, variantId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  userId     String
  wigStyleId String
  createdAt  DateTime @default(now())

  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  style WigStyle @relation(fields: [wigStyleId], references: [id])

  @@unique([userId, wigStyleId])
}

// ============================================================
// 주문 (규칙 4-2: 가격 스냅샷 필수)
// ============================================================

/// 지원 국가. 주소 필드 해석 기준이 된다.
enum ShippingCountry {
  KR // 대한민국
  US // 미국
  JP // 일본
}

model Order {
  id            String          @id @default(cuid())
  userId        String
  status        OrderStatus     @default(PENDING)
  totalAmount   Int
  paymentId     String?
  paymentMethod String?
  paymentStatus PaymentStatus   @default(PENDING)

  // ── 배송지 (국제 공통 구조) ─────────────────────────────────
  // 필드별 한국(KR) / 미국(US) / 일본(JP) 대응 예시:
  //
  // recipientName   : 홍길동          / John Doe         / 山田太郎
  // phone           : 010-1234-5678   / +1-555-123-4567  / 090-1234-5678
  // country         : KR              / US               / JP
  // postalCode      : 06234           / 90210            / 150-0001
  // administrativeArea: 서울특별시    / California       / 東京都
  // city            : 강남구          / Los Angeles      / 渋谷区
  // addressLine1    : 테헤란로 152    / 123 Main St      / 道玄坂1-2-3
  // addressLine2    : 7층 701호       / Apt 4B           / ○○ビル5F  (nullable)

  recipientName      String
  phone              String
  country            ShippingCountry
  postalCode         String
  administrativeArea String?         // nullable — KR 단일 직할시 등 생략 가능
  city               String
  addressLine1       String
  addressLine2       String?         // 상세주소 / apt·unit / 建物·部屋番号

  memo          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

enum OrderStatus {
  PENDING
  CONFIRMED
  MANUFACTURING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  variantId    String
  quantity     Int
  unitPrice    Int
  snapshotData Json

  order   Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant WigVariant @relation(fields: [variantId], references: [id])

  manufacturingRequest ManufacturingRequest?
}

// ============================================================
// 제조 지시 (MVP: 레코드만, UI는 나중)
// ============================================================

model ManufacturingRequest {
  id          String   @id @default(cuid())
  orderItemId String   @unique
  status      String   @default("PENDING")
  hairCadKey  String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
}

// ============================================================
// 리뷰 (자리만, UI는 2차)
// ============================================================

model Review {
  id         String   @id @default(cuid())
  userId     String
  wigStyleId String
  rating     Int
  body       String?  @db.Text
  imageKeys  String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  style WigStyle @relation(fields: [wigStyleId], references: [id])

  @@unique([userId, wigStyleId])
}
