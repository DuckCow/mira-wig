// ============================================================
// prisma/schema.prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// 인증
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  fittings         Fitting[]
  reviews          Review[]
  wishlistItems    WishlistItem[]
  cartItems        CartItem[]
  checkoutSessions CheckoutSession[]
  orders           Order[]
}

enum UserRole {
  CUSTOMER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// 마켓 (Market) — 통화·배송권역·가격의 단일 출처
// ============================================================

model Market {
  code               String   @id // "KR" | "US" | "JP"
  currency           String // "KRW" | "USD" | "JPY"
  shippableCountries String[] // 배송 가능 국가 코드 목록
  defaultLocale      String // "ko" | "en" | "ja"
  isActive           Boolean  @default(true)

  // ── 향후 확장 슬롯 (이번에 구현하지 않음) ────────────────────
  // taxConfig     : 세율·세금 유형 (미국 sales tax, 일본 소비세 등)
  // paymentConfig : 결제 수단 목록 (토스/Stripe/PayPay 등)
  taxConfig     Json?
  paymentConfig Json?

  variantPrices    VariantMarketPrice[]
  availableStyles  WigStyleMarket[]
  checkoutSessions CheckoutSession[]
  orders           Order[]
}

/// 변형(Variant) × 마켓 별 가격.
/// amount는 해당 통화의 최소단위 정수:
///   KRW(zero-decimal): ₩30,000 → 30000
///   USD(2-decimal):    $29.99  → 2999
///   JPY(zero-decimal): ¥1,500  → 1500
model VariantMarketPrice {
  variantId  String
  marketCode String
  amount     Int // 최소단위 정수 — float 절대 금지

  variant WigVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  market  Market     @relation(fields: [marketCode], references: [code], onDelete: Cascade)

  @@id([variantId, marketCode])
}

/// 스타일별 마켓 가용성. isActive=false 이면 해당 마켓에서 미노출.
model WigStyleMarket {
  wigStyleId String
  marketCode String
  isActive   Boolean @default(true)

  wigStyle WigStyle @relation(fields: [wigStyleId], references: [id], onDelete: Cascade)
  market   Market   @relation(fields: [marketCode], references: [code], onDelete: Cascade)

  @@id([wigStyleId, marketCode])
}

// ============================================================
// 가발 카탈로그
// ============================================================

enum WigCategory {
  HAIR_LOSS
  FASHION
  COSPLAY
  TOPPER
  MEDICAL
}

enum FulfillmentType {
  MTO
  STOCKED
}

model WigStyle {
  id            String      @id @default(cuid())
  name          String
  description   String?     @db.Text
  category      WigCategory
  tags          String[]
  coverImageKey String?
  imageKeys     String[]
  sortOrder     Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  variants         WigVariant[]
  reviews          Review[]
  wishlistItems    WishlistItem[]
  cartItems        CartItem[]
  availableMarkets WigStyleMarket[]
}

model WigVariant {
  id              String          @id @default(cuid())
  wigStyleId      String
  color           String
  colorHex        String?
  length          String
  curl            String
  /// KRW 기준가 (장바구니 하위 호환용). 카탈로그 표시는 VariantMarketPrice를 사용할 것.
  price           Int
  stock           Int             @default(0)
  sku             String          @unique
  isActive        Boolean         @default(true)
  fulfillmentType FulfillmentType @default(MTO)

  wigStyle     WigStyle              @relation(fields: [wigStyleId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  marketPrices VariantMarketPrice[]
  fittings     Fitting[]
  sessionLines CheckoutSessionLine[]
  orderItems   OrderItem[]
}

// ============================================================
// 피팅 (Fitting) — AI 가상 피팅 결과 영속
// ============================================================

enum FittingStatus {
  PENDING // provider에 요청 완료, 결과 대기
  SUCCEEDED // 성공 — resultImageKey 저장됨
  FAILED // 실패 — failureReason 저장됨
}

/// 사용자 1회 피팅 시도. sourceImageKey/resultImageKey는 S3 key (URL 금지).
model Fitting {
  id             String        @id @default(cuid())
  userId         String
  variantId      String
  status         FittingStatus @default(PENDING)
  /// 소스(얼굴) 이미지 S3 key — 보존 정책상 나중에 삭제 가능 (nullable)
  sourceImageKey String?
  /// 결과 이미지 S3 key — SUCCEEDED 시 저장
  resultImageKey String?
  /// 외부 AI provider가 발급한 job ID
  providerJobId  String?
  /// FAILED 시 실패 이유 (provider 응답)
  failureReason  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant WigVariant @relation(fields: [variantId], references: [id])
}

// ============================================================
// 장바구니 & 위시리스트
// ============================================================

model CartItem {
  id         String   @id @default(cuid())
  userId     String
  wigStyleId String
  variantId  String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  style   WigStyle   @relation(fields: [wigStyleId], references: [id])
  variant WigVariant @relation(fields: [variantId], references: [id])

  @@unique([userId, variantId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  userId     String
  wigStyleId String
  createdAt  DateTime @default(now())

  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  style WigStyle @relation(fields: [wigStyleId], references: [id])

  @@unique([userId, wigStyleId])
}

// ============================================================
// 신 결제 코어 v0 — 정책 v5
// ============================================================

enum CheckoutSessionStatus {
  OPEN
  SUBMITTED
  COMPLETED
  FAILED
  EXPIRED
}

enum PaymentProvider {
  MOCK
  TOSS
  PAYPAL
}

enum PaymentMode {
  SANDBOX
  LIVE
}

enum PaymentAttemptStatus {
  INITIATED
  AWAITING
  SUCCEEDED
  FAILED
  VOIDED
}

enum OrderStatus {
  PAID
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum MrStatus {
  RECEIVED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum PaymentEventSource {
  WEBHOOK
  API
}

enum PaymentEventStatus {
  RECEIVED
  RETRYABLE_FAILED
  PROCESSED
  IGNORED
  FAILED
}

enum PaymentEventFailureStage {
  PARSE
  COMPLETE
}

enum WebhookIngressRejectionStage {
  METADATA_EXTRACT
  VERIFY
}

enum ShippingCountry {
  KR
  US
  JP
}

model CheckoutSession {
  id             String                @id @default(cuid())
  userId         String
  user           User                  @relation(fields: [userId], references: [id])
  marketCode     String
  market         Market                @relation(fields: [marketCode], references: [code])
  currency       String
  status         CheckoutSessionStatus @default(OPEN)
  subtotalAmount Int
  shippingAmount Int                   @default(0)
  totalAmount    Int
  expiresAt      DateTime
  submittedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  lines    CheckoutSessionLine[]
  shipping CheckoutSessionShipping?
  payments Payment[]
  order    Order?

  @@index([userId, status])
  @@index([status, expiresAt])
}

model CheckoutSessionLine {
  id              String          @id @default(cuid())
  sessionId       String
  session         CheckoutSession @relation(fields: [sessionId], references: [id])
  variantId       String
  variant         WigVariant      @relation(fields: [variantId], references: [id])
  quantity        Int
  unitAmount      Int
  fulfillmentType FulfillmentType
  snapshotData    Json
  createdAt       DateTime        @default(now())

  @@unique([sessionId, variantId])
}

model CheckoutSessionShipping {
  sessionId          String          @id
  session            CheckoutSession @relation(fields: [sessionId], references: [id])
  recipientName      String
  phone              String
  country            ShippingCountry
  postalCode         String
  administrativeArea String
  city               String
  addressLine1       String
  addressLine2       String?
  memo               String?
}

model Payment {
  id                            String               @id @default(cuid())
  checkoutSessionId             String
  session                       CheckoutSession      @relation(fields: [checkoutSessionId], references: [id])
  provider                      PaymentProvider
  mode                          PaymentMode
  status                        PaymentAttemptStatus @default(INITIATED)
  amount                        Int
  currency                      String
  providerRef                   String?
  providerConfirmIdempotencyKey String?              @unique
  providerPaymentKey            String?
  idempotencyKey                String               @unique
  errorCode                     String?
  errorMessage                  String?
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt
  order                         Order?

  @@unique([provider, providerPaymentKey])
  @@index([provider, providerRef])
  @@index([checkoutSessionId, status])
}

model Order {
  id                String          @id @default(cuid())
  checkoutSessionId String          @unique
  session           CheckoutSession @relation(fields: [checkoutSessionId], references: [id])
  paymentId         String          @unique
  payment           Payment         @relation(fields: [paymentId], references: [id])
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  marketCode        String
  market            Market          @relation(fields: [marketCode], references: [code])
  currency          String
  subtotalAmount    Int
  shippingAmount    Int
  totalAmount       Int
  status            OrderStatus     @default(PAID)
  disputeStatus     String?
  paidAt            DateTime
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  items    OrderItem[]
  shipping OrderShipping?

  @@index([userId, createdAt])
}

model OrderItem {
  id              String                @id @default(cuid())
  orderId         String
  order           Order                 @relation(fields: [orderId], references: [id])
  variantId       String
  variant         WigVariant            @relation(fields: [variantId], references: [id])
  quantity        Int
  unitAmount      Int
  fulfillmentType FulfillmentType
  snapshotData    Json
  mr              ManufacturingRequest?

  @@unique([orderId, variantId])
}

model OrderShipping {
  orderId            String          @id
  order              Order           @relation(fields: [orderId], references: [id])
  recipientName      String
  phone              String
  country            ShippingCountry
  postalCode         String
  administrativeArea String
  city               String
  addressLine1       String
  addressLine2       String?
  memo               String?
  updatedAt          DateTime        @updatedAt
}

model ManufacturingRequest {
  id          String    @id @default(cuid())
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  status      MrStatus  @default(RECEIVED)
  startedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PaymentOutbox {
  id            String       @id @default(cuid())
  topic         String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime?
  lastError     String?
  dedupKey      String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  processedAt   DateTime?

  @@index([status, nextAttemptAt])
}

model PaymentEvent {
  id                        String                    @id @default(cuid())
  provider                  PaymentProvider
  source                    PaymentEventSource
  transmissionId            String?
  eventType                 String
  verifiedMode              PaymentMode?
  verifiedCredentialBinding String?
  checkoutSessionId         String?
  providerPaymentKey        String?
  raw                       Json
  status                    PaymentEventStatus        @default(RECEIVED)
  receivedAt                DateTime                  @default(now())
  processedAt               DateTime?
  attemptCount              Int                       @default(0)
  lastAttemptAt             DateTime?
  failureStage              PaymentEventFailureStage?
  failureCode               String?
  lastError                 String?

  @@unique([provider, transmissionId])
  @@index([checkoutSessionId])
}

model WebhookIngressRejection {
  id                      String                       @id @default(cuid())
  provider                PaymentProvider
  stage                   WebhookIngressRejectionStage
  code                    String
  candidateTransmissionId String?
  candidateEventType      String?
  rawBodyBytes            Int
  rawBodyHash             String?
  rawBodyPrefix           String?                      @db.Text
  lastError               String?
  receivedAt              DateTime                     @default(now())
  createdAt               DateTime                     @default(now())

  @@index([provider, receivedAt])
  @@index([candidateTransmissionId])
}

// ============================================================
// 리뷰 (자리만, UI는 2차)
// ============================================================

model Review {
  id         String   @id @default(cuid())
  userId     String
  wigStyleId String
  rating     Int
  body       String?  @db.Text
  imageKeys  String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  style WigStyle @relation(fields: [wigStyleId], references: [id])

  @@unique([userId, wigStyleId])
}
