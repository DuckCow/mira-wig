// ============================================================
// prisma/schema.prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// 인증
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  fittings              Fitting[]
  reviews               Review[]
  wishlistItems         WishlistItem[]
  cartItems             CartItem[]
  checkoutSessions      CheckoutSession[]
  orders                Order[]
  customerRefundIntakes CustomerRefundIntake[]
}

enum UserRole {
  CUSTOMER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// 마켓 (Market) — 통화·배송권역·가격의 단일 출처
// ============================================================

model Market {
  code               String   @id // "KR" | "US" | "JP"
  currency           String // "KRW" | "USD" | "JPY"
  shippableCountries String[] // 배송 가능 국가 코드 목록
  defaultLocale      String // "ko" | "en" | "ja"
  isActive           Boolean  @default(true)

  // ── 향후 확장 슬롯 (이번에 구현하지 않음) ────────────────────
  // taxConfig     : 세율·세금 유형 (미국 sales tax, 일본 소비세 등)
  // paymentConfig : 결제 수단 목록 (토스/Stripe/PayPay 등)
  taxConfig     Json?
  paymentConfig Json?

  variantPrices     VariantMarketPrice[]
  availableStyles   WigStyleMarket[]
  wigStyleRelations WigStyleRelation[]
  checkoutSessions  CheckoutSession[]
  orders            Order[]
}

/// 변형(Variant) × 마켓 별 가격.
/// amount는 해당 통화의 최소단위 정수:
///   KRW(zero-decimal): ₩30,000 → 30000
///   USD(2-decimal):    $29.99  → 2999
///   JPY(zero-decimal): ¥1,500  → 1500
model VariantMarketPrice {
  variantId  String
  marketCode String
  amount     Int // 최소단위 정수 — float 절대 금지

  variant WigVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  market  Market     @relation(fields: [marketCode], references: [code], onDelete: Cascade)

  @@id([variantId, marketCode])
}

/// 스타일별 마켓 가용성. isActive=false 이면 해당 마켓에서 미노출.
model WigStyleMarket {
  wigStyleId String
  marketCode String
  isActive   Boolean @default(true)

  wigStyle WigStyle @relation(fields: [wigStyleId], references: [id], onDelete: Cascade)
  market   Market   @relation(fields: [marketCode], references: [code], onDelete: Cascade)

  @@id([wigStyleId, marketCode])
}

// ============================================================
// 가발 카탈로그
// ============================================================

enum WigCategory {
  HAIR_LOSS
  FASHION
  COSPLAY
  TOPPER
  MEDICAL
}

enum FulfillmentType {
  MTO
  STOCKED
}

enum WigStyleRelationPurpose {
  SIMILAR_STYLE
  COMPARE_WITH
}

model WigStyle {
  id            String      @id @default(cuid())
  name          String
  description   String?     @db.Text
  category      WigCategory
  tags          String[]
  coverImageKey String?
  imageKeys     String[]
  sortOrder     Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  variants         WigVariant[]
  reviews          Review[]
  wishlistItems    WishlistItem[]
  cartItems        CartItem[]
  availableMarkets WigStyleMarket[]
  sourceRelations  WigStyleRelation[] @relation("WigStyleRelationSource")
  targetRelations  WigStyleRelation[] @relation("WigStyleRelationTarget")
}

model WigStyleRelation {
  id                   String                  @id @default(cuid())
  sourceStyleId        String
  targetStyleId        String
  marketCode           String
  purpose              WigStyleRelationPurpose
  priority             Int                     @default(0)
  isActive             Boolean                 @default(false)
  internalRationale    String?                 @db.VarChar(500)
  createdByAdminUserId String
  updatedByAdminUserId String
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  sourceStyle WigStyle @relation("WigStyleRelationSource", fields: [sourceStyleId], references: [id], onDelete: Restrict)
  targetStyle WigStyle @relation("WigStyleRelationTarget", fields: [targetStyleId], references: [id], onDelete: Restrict)
  market      Market   @relation(fields: [marketCode], references: [code], onDelete: Restrict)

  @@unique([sourceStyleId, targetStyleId, marketCode])
  @@index([sourceStyleId, marketCode, isActive, purpose, priority], map: "WigStyleRelation_sourceStyleId_marketCode_isActive_purpose_prio")
  @@index([targetStyleId])
}

model WigVariant {
  id              String          @id @default(cuid())
  wigStyleId      String
  color           String
  colorHex        String?
  length          String
  curl            String
  /// KRW 기준가 (장바구니 하위 호환용). 카탈로그 표시는 VariantMarketPrice를 사용할 것.
  price           Int
  stock           Int             @default(0)
  sku             String          @unique
  isActive        Boolean         @default(true)
  fulfillmentType FulfillmentType @default(MTO)

  wigStyle     WigStyle              @relation(fields: [wigStyleId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  marketPrices VariantMarketPrice[]
  fittings     Fitting[]
  sessionLines CheckoutSessionLine[]
  orderItems   OrderItem[]
}

// ============================================================
// 피팅 (Fitting) — AI 가상 피팅 결과 영속
// ============================================================

enum FittingStatus {
  PENDING // provider에 요청 완료, 결과 대기
  SUCCEEDED // 성공 — resultImageKey 저장됨
  FAILED // 실패 — failureReason 저장됨
}

/// 사용자 1회 피팅 시도. sourceImageKey/resultImageKey는 S3 key (URL 금지).
model Fitting {
  id             String        @id @default(cuid())
  userId         String
  variantId      String
  status         FittingStatus @default(PENDING)
  /// 소스(얼굴) 이미지 S3 key — 보존 정책상 나중에 삭제 가능 (nullable)
  sourceImageKey String?
  /// 결과 이미지 S3 key — SUCCEEDED 시 저장
  resultImageKey String?
  /// 외부 AI provider가 발급한 job ID
  providerJobId  String?
  /// FAILED 시 실패 이유 (provider 응답)
  failureReason  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant WigVariant @relation(fields: [variantId], references: [id])
}

// ============================================================
// 장바구니 & 위시리스트
// ============================================================

model CartItem {
  id         String   @id @default(cuid())
  userId     String
  wigStyleId String
  variantId  String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  style   WigStyle   @relation(fields: [wigStyleId], references: [id])
  variant WigVariant @relation(fields: [variantId], references: [id])

  @@unique([userId, variantId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  userId     String
  wigStyleId String
  createdAt  DateTime @default(now())

  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  style WigStyle @relation(fields: [wigStyleId], references: [id])

  @@unique([userId, wigStyleId])
}

// ============================================================
// 신 결제 코어 v0 — 정책 v5
// ============================================================

enum CheckoutSessionStatus {
  OPEN
  SUBMITTED
  COMPLETED
  FAILED
  EXPIRED
}

enum PaymentProvider {
  MOCK
  TOSS
  PAYPAL
  EXIMBAY
}

enum PaymentMode {
  SANDBOX
  LIVE
}

enum PaymentAttemptStatus {
  INITIATED
  AWAITING
  SUCCEEDED
  FAILED
  VOIDED
}

enum PaymentAttemptLifecycle {
  CONTACT_AUTHORIZED
  CONTACTED
  OUTCOME_UNKNOWN
  SUPERSEDED
  TERMINAL_FAILURE
  SUSPENDED
  FINALIZED
  TERMINAL_REMEDIATED
}

enum PaymentInitiationOutputKind {
  READY
  REDIRECT
}

enum PaymentRemediationStatus {
  NONE
  REQUIRED
  PENDING
  RECONCILIATION_REQUIRED
  REMEDIATED
}

enum PaymentRemediationOperation {
  VOID
  CANCEL
  REVERSAL
  REFUND
  MANUAL_RECONCILIATION
}

enum RefundAttemptStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_TERMINAL
  MANUAL_REVIEW
  CANCELLED
}

enum RefundAttemptActorType {
  ADMIN
  SYSTEM
}

enum CustomerRefundIntakeStatus {
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum CustomerRefundIntakeReasonCode {
  CHANGE_OF_MIND
  PRODUCT_DEFECT
  DELIVERY_ISSUE
  OTHER
}

enum RefundExecutionCommandStatus {
  READY
  LEASED
  WAITING_EVIDENCE
  WAITING_RETRY
  PARKED
  DONE
}

enum RefundExecutionCommandEventType {
  LEASE_ACQUIRED
  PRE_CONTACT_RELEASED
  RECOVERY_LEASE_ACQUIRED
}

enum RefundExecutionDispatchAttemptState {
  AUTHORIZED
  CONTACT_MAY_HAVE_OCCURRED
}

enum RefundExecutionEvidenceSource {
  ADAPTER_RESPONSE
  PROVIDER_LOOKUP
  WEBHOOK
  RECONCILIATION
  OPERATOR
}

enum RefundExecutionEvidenceOutcome {
  SUCCEEDED
  ACCEPTED_PENDING
  NOT_EXECUTED_RETRYABLE
  NOT_EXECUTED_TERMINAL
  UNKNOWN
}

enum RefundExecutionEvidenceApplication {
  APPLIED
  PARKED
  DUPLICATE
  CONFLICT
}

enum OrderStatus {
  PAID
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum MrStatus {
  RECEIVED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum PaymentEventSource {
  WEBHOOK
  API
}

enum PaymentEventStatus {
  RECEIVED
  RETRYABLE_FAILED
  PROCESSED
  IGNORED
  FAILED
}

enum PaymentEventFailureStage {
  PARSE
  COMPLETE
}

enum WebhookIngressRejectionStage {
  METADATA_EXTRACT
  VERIFY
}

enum ShippingCountry {
  KR
  US
  JP
}

model CheckoutSession {
  id             String                @id @default(cuid())
  userId         String
  user           User                  @relation(fields: [userId], references: [id])
  marketCode     String
  market         Market                @relation(fields: [marketCode], references: [code])
  currency       String
  status         CheckoutSessionStatus @default(OPEN)
  subtotalAmount Int
  shippingAmount Int                   @default(0)
  totalAmount    Int
  expiresAt      DateTime
  submittedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  lines    CheckoutSessionLine[]
  shipping CheckoutSessionShipping?
  payments Payment[]
  order    Order?

  @@index([userId, status])
  @@index([status, expiresAt])
}

model CheckoutSessionLine {
  id              String          @id @default(cuid())
  sessionId       String
  session         CheckoutSession @relation(fields: [sessionId], references: [id])
  /// Exact mutable CartItem identity from which a cart-checkout line was frozen.
  /// Used only to bound successful-completion cart cleanup; not commercial/order authority.
  sourceCartItemId String?
  variantId       String
  variant         WigVariant      @relation(fields: [variantId], references: [id])
  /// Cart-selected parent identity. This is not inferred from variantId at completion.
  wigStyleId      String
  quantity        Int
  unitAmount      Int
  fulfillmentType FulfillmentType
  snapshotData    Json
  createdAt       DateTime        @default(now())

  @@unique([sessionId, variantId])
  @@index([sourceCartItemId])
}

model CheckoutSessionShipping {
  sessionId          String          @id
  session            CheckoutSession @relation(fields: [sessionId], references: [id])
  recipientName      String
  phone              String
  country            ShippingCountry
  postalCode         String
  administrativeArea String
  city               String
  addressLine1       String
  addressLine2       String?
  memo               String?
}

model Payment {
  id                            String                       @id @default(cuid())
  checkoutSessionId             String
  session                       CheckoutSession              @relation(fields: [checkoutSessionId], references: [id])
  provider                      PaymentProvider
  mode                          PaymentMode
  routingRuleId                 String?
  /// Financial result axis. Logical attempt/contact authority is attemptLifecycle.
  status                        PaymentAttemptStatus         @default(INITIATED)
  attemptLifecycle              PaymentAttemptLifecycle
  remediationStatus             PaymentRemediationStatus     @default(NONE)
  amount                        Int
  currency                      String
  providerOrderId              String?
  providerRef                   String?
  providerConfirmIdempotencyKey String?                      @unique
  providerPaymentKey            String?
  idempotencyKey                String                       @unique
  contactIntentAt               DateTime?
  contactStartedAt              DateTime?
  initiationOutputKind          PaymentInitiationOutputKind?
  initiationApproveUrl          String?
  initiationCompletedAt         DateTime?
  financialSucceededAt          DateTime?
  errorCode                     String?
  errorMessage                  String?
  supersededAt                  DateTime?
  blockingEndedAt               DateTime?
  suspendedByPaymentId          String?
  suspendedByPayment            Payment?                     @relation("PaymentRemediationBlock", fields: [checkoutSessionId, suspendedByPaymentId], references: [checkoutSessionId, id], onDelete: Restrict)
  suspendedPayments             Payment[]                    @relation("PaymentRemediationBlock")
  remediationOperation          PaymentRemediationOperation?
  remediationResultRef          String?
  remediatedAt                  DateTime?
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  order                         Order?
  refundAttempts                RefundAttempt[]

  @@unique([provider, providerPaymentKey])
  @@unique([provider, providerOrderId])
  @@unique([checkoutSessionId, id])
  @@index([provider, providerRef])
  @@index([checkoutSessionId, status])
  @@index([checkoutSessionId, attemptLifecycle])
  @@index([suspendedByPaymentId])
}

model Order {
  id                String          @id @default(cuid())
  checkoutSessionId String          @unique
  session           CheckoutSession @relation(fields: [checkoutSessionId], references: [id])
  paymentId         String          @unique
  payment           Payment         @relation(fields: [paymentId], references: [id])
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  marketCode        String
  market            Market          @relation(fields: [marketCode], references: [code])
  currency          String
  subtotalAmount    Int
  shippingAmount    Int
  totalAmount       Int
  status            OrderStatus     @default(PAID)
  disputeStatus     String?
  paidAt            DateTime
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  items                 OrderItem[]
  shipping              OrderShipping?
  refundAttempts        RefundAttempt[]
  customerRefundIntakes CustomerRefundIntake[]

  @@index([userId, createdAt])
}

/// Manual database invariants are owned by the migration and real-PostgreSQL tests per
/// docs/payment_policy/customer_refund_intake_v1.md: CustomerRefundIntake_orderId_submitted_key
/// and the eight CustomerRefundIntake_* CHECK constraints. `prisma validate` does not enforce them.
/// reviewedByUserId is an immutable authenticated actor-ID snapshot and deliberately has no User FK.
/// Migration-owned btrim checks narrowly reject simple blank raw writes; full Unicode trimming,
/// Cc/Cf handling, authorization, and normalization remain future-core responsibilities.
model CustomerRefundIntake {
  id                      String                         @id @default(cuid())
  orderId                 String
  customerUserId          String
  status                  CustomerRefundIntakeStatus     @default(SUBMITTED)
  reasonCode              CustomerRefundIntakeReasonCode
  reasonDetail            String?                        @db.VarChar(500)
  submittedAt             DateTime                       @default(now())
  withdrawnAt             DateTime?
  reviewedAt              DateTime?
  reviewedByUserId        String?
  adminRejectionReason    String?                        @db.VarChar(500)
  approvedRefundAttemptId String?                        @unique
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt

  order                 Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer              User           @relation(fields: [customerUserId], references: [id], onDelete: Restrict)
  approvedRefundAttempt RefundAttempt? @relation(fields: [approvedRefundAttemptId], references: [id], onDelete: Restrict)

  @@index([orderId, submittedAt])
  @@index([status, submittedAt])
}

model RefundAttempt {
  id                           String                                   @id @default(cuid())
  orderId                      String
  order                        Order                                    @relation(fields: [orderId], references: [id])
  paymentId                    String
  payment                      Payment                                  @relation(fields: [paymentId], references: [id])
  amount                       Int
  currency                     String
  status                       RefundAttemptStatus                      @default(REQUESTED)
  reason                       String
  actorType                    RefundAttemptActorType
  actorUserId                  String?
  provider                     PaymentProvider
  mode                         PaymentMode
  providerRefundId             String?
  idempotencyKey               String                                   @unique
  requestedAt                  DateTime                                 @default(now())
  processedAt                  DateTime?
  failedAt                     DateTime?
  failureCode                  String?
  safeFailureMessage           String?
  createdAt                    DateTime                                 @default(now())
  updatedAt                    DateTime                                 @updatedAt
  transitions                  RefundAttemptTransition[]
  executionCommand             RefundExecutionCommand?
  providerOperationBinding     RefundExecutionProviderOperationBinding?
  approvedCustomerRefundIntake CustomerRefundIntake?

  @@unique([provider, providerRefundId])
  @@index([orderId, status])
  @@index([paymentId, status])
  @@index([orderId, requestedAt])
}

model RefundAttemptTransition {
  id String @id @default(cuid())

  refundAttemptId String
  refundAttempt   RefundAttempt @relation(fields: [refundAttemptId], references: [id], onDelete: Restrict)

  fromStatus RefundAttemptStatus?
  toStatus   RefundAttemptStatus

  orderStatusBefore OrderStatus
  orderStatusAfter  OrderStatus

  actorType   RefundAttemptActorType
  actorUserId String?

  reason       String
  operationKey String   @unique
  createdAt    DateTime @default(now())

  @@index([refundAttemptId, createdAt])
}

model RefundExecutionCommand {
  id              String        @id @default(cuid())
  refundAttemptId String        @unique
  refundAttempt   RefundAttempt @relation(fields: [refundAttemptId], references: [id], onDelete: Restrict)

  status          RefundExecutionCommandStatus @default(READY)
  availableAt     DateTime                     @default(now())
  leaseOwner      String?                      @db.VarChar(255)
  leaseUntil      DateTime?
  leaseGeneration Int                          @default(0)
  leaseTokenHash  String?                      @db.VarChar(64)
  dispatchAttempt Int                          @default(0)

  lastSafeErrorCode    String? @db.VarChar(128)
  lastSafeErrorMessage String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence         RefundExecutionEvidence[]
  events           RefundExecutionCommandEvent[]
  dispatchAttempts RefundExecutionDispatchAttempt[]

  @@index([status, availableAt, createdAt])
  @@index([status, leaseUntil])
}

model RefundExecutionCommandEvent {
  id              String                          @id @default(cuid())
  commandId       String
  eventType       RefundExecutionCommandEventType
  leaseGeneration Int
  dispatchAttempt Int
  occurredAt      DateTime                        @db.Timestamp(3)
  createdAt       DateTime                        @default(now()) @db.Timestamp(3)

  command RefundExecutionCommand @relation(fields: [commandId], references: [id], onDelete: Restrict)

  @@unique([commandId, leaseGeneration, eventType], map: "RefundExecutionCommandEvent_commandId_leaseGeneration_eventType")
  @@index([commandId, occurredAt])
}

model RefundExecutionDispatchAttempt {
  id                   String                              @id @default(cuid())
  commandId            String
  ordinal              Int
  leaseGeneration      Int
  provider             PaymentProvider
  mode                 PaymentMode
  providerOperationKey String                              @db.VarChar(512)
  requestFingerprint   String                              @db.VarChar(64)
  state                RefundExecutionDispatchAttemptState
  authorizedAt         DateTime                            @db.Timestamp(3)
  contactMarkedAt      DateTime?                           @db.Timestamp(3)
  createdAt            DateTime                            @default(now()) @db.Timestamp(3)

  command                 RefundExecutionCommand                          @relation(fields: [commandId], references: [id], onDelete: Restrict)
  contactEligibilityProof RefundExecutionProviderContactEligibilityProof?
  evidence                RefundExecutionEvidence[]

  @@unique([commandId, ordinal])
}

/// Immutable normalized Toss eligibility facts observed for one physical
/// dispatch immediately before contact authorization. E3B2A adds no writer.
model RefundExecutionProviderContactEligibilityProof {
  id                     String   @id(map: "RefundContactProof_pkey") @default(cuid())
  dispatchAttemptId      String   @unique(map: "RefundContactProof_dispatch_key")
  paymentKey             String   @db.VarChar(200)
  method                 String   @db.VarChar(64)
  easyPayPresent         Boolean
  currency               String   @db.VarChar(3)
  providerStatus         String   @db.VarChar(32)
  totalAmount            Int
  balanceAmount          Int
  taxFreeAmount          Int
  taxExemptionAmount     Int
  cancelsCount           Int
  localReceivedAt        DateTime @db.Timestamp(3)
  eligibilityFingerprint String   @db.VarChar(64)
  createdAt              DateTime @default(now()) @db.Timestamp(3)

  dispatchAttempt RefundExecutionDispatchAttempt @relation(fields: [dispatchAttemptId], references: [id], onDelete: Restrict, map: "RefundContactProof_dispatch_fkey")
}

/// Immutable attempt-stable provider operation-family authority. Physical
/// merchant wire keys remain owned by RefundExecutionDispatchAttempt.
model RefundExecutionProviderOperationBinding {
  id                                 String          @id(map: "RefundProviderBinding_pkey") @default(cuid())
  refundAttemptId                    String          @unique(map: "RefundProviderBinding_refundAttempt_key")
  provider                           PaymentProvider
  mode                               PaymentMode
  providerOperationFamilyKey         String          @unique(map: "RefundProviderBinding_operationKey_key") @map("providerOperationKey") @db.VarChar(300)
  operationFamilyKeyAlgorithmVersion String          @map("operationKeyAlgorithmVersion") @db.VarChar(64)
  wireContractVersion                String          @db.VarChar(64)
  operationFamilyFingerprint         String          @map("wireRequestFingerprint") @db.VarChar(64)
  merchantAccountBindingId           String          @db.VarChar(64)
  credentialGenerationBindingId      String          @db.VarChar(64)
  createdAt                          DateTime        @default(now()) @db.Timestamp(3)

  refundAttempt    RefundAttempt                            @relation(fields: [refundAttemptId], references: [id], onDelete: Restrict, map: "RefundProviderBinding_refundAttempt_fkey")
  eligibilityProof RefundExecutionProviderEligibilityProof?
  eximbayPreflightObservations RefundExecutionEximbayPreflightObservation[]
}

/// Immutable Eximbay payment state admitted before the first physical cancel
/// dispatch is authorized. Provider/account provenance is inherited from binding.
model RefundExecutionEximbayPreflightObservation {
  id                       String @id @default(cuid())
  bindingId                String
  observingLeaseGeneration Int

  mid                   String @db.VarChar(512)
  providerOrderId       String @db.VarChar(512)
  providerTransactionId String @db.VarChar(512)
  providerStatus        String @db.VarChar(32)
  currency              String @db.VarChar(3)
  originalAmount        Int
  refundableBalance     Int

  observedAt             DateTime @db.Timestamp(3)
  inquiryContractVersion String   @db.VarChar(64)
  parserVersion          String   @db.VarChar(64)
  observationFingerprint String   @unique(map: "RefundExecutionEximbayPreflightObservation_observationFingerpri") @db.VarChar(64)
  createdAt              DateTime @default(now()) @db.Timestamp(3)

  binding RefundExecutionProviderOperationBinding @relation(fields: [bindingId], references: [id], onDelete: Restrict)

  @@unique([bindingId, observingLeaseGeneration], map: "EximbayPreflight_binding_generation_key")
}

/// Immutable normalized pre-first-contact Toss eligibility facts. Raw Toss
/// responses and credential material never belong in this table.
model RefundExecutionProviderEligibilityProof {
  id                     String   @id(map: "RefundEligibilityProof_pkey") @default(cuid())
  bindingId              String   @unique(map: "RefundEligibilityProof_binding_key")
  paymentKey             String   @db.VarChar(200)
  method                 String   @db.VarChar(64)
  easyPayPresent         Boolean
  currency               String   @db.VarChar(3)
  providerStatus         String   @db.VarChar(32)
  totalAmount            Int
  balanceAmount          Int
  taxFreeAmount          Int
  taxExemptionAmount     Int
  cancelsCount           Int
  localReceivedAt        DateTime @db.Timestamp(3)
  eligibilityFingerprint String   @db.VarChar(64)
  createdAt              DateTime @default(now()) @db.Timestamp(3)

  binding RefundExecutionProviderOperationBinding @relation(fields: [bindingId], references: [id], onDelete: Restrict, map: "RefundEligibilityProof_binding_fkey")
}

model RefundExecutionEvidence {
  id        String                 @id @default(cuid())
  commandId String
  command   RefundExecutionCommand @relation(fields: [commandId], references: [id], onDelete: Restrict)

  source         RefundExecutionEvidenceSource
  sourceDedupKey String                             @unique @db.VarChar(512)
  outcome        RefundExecutionEvidenceOutcome
  application    RefundExecutionEvidenceApplication

  observedProviderRefundId String? @db.VarChar(512)
  reportedAmount           Int?
  reportedCurrency         String? @db.VarChar(3)

  safeCode    String? @db.VarChar(128)
  safeMessage String? @db.VarChar(500)

  observedAt DateTime
  createdAt  DateTime @default(now())

  dispatchAttemptId          String?
  dispatchAttempt            RefundExecutionDispatchAttempt? @relation(fields: [dispatchAttemptId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "RefundEvidence_dispatch_fkey")
  authorizingLeaseGeneration Int?

  @@index([commandId, createdAt])
  @@index([source, observedAt])
  @@index([dispatchAttemptId], map: "RefundEvidence_dispatch_idx")
}

model OrderItem {
  id              String                @id @default(cuid())
  orderId         String
  order           Order                 @relation(fields: [orderId], references: [id])
  variantId       String
  variant         WigVariant            @relation(fields: [variantId], references: [id])
  /// Checkout-selected parent identity snapshot.
  wigStyleId      String
  quantity        Int
  unitAmount      Int
  fulfillmentType FulfillmentType
  snapshotData    Json
  mr              ManufacturingRequest?

  @@unique([orderId, variantId])
}

model OrderShipping {
  orderId            String          @id
  order              Order           @relation(fields: [orderId], references: [id])
  recipientName      String
  phone              String
  country            ShippingCountry
  postalCode         String
  administrativeArea String
  city               String
  addressLine1       String
  addressLine2       String?
  memo               String?
  updatedAt          DateTime        @updatedAt
}

model ManufacturingRequest {
  id          String    @id @default(cuid())
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  status      MrStatus  @default(RECEIVED)
  startedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PaymentOutbox {
  id            String       @id @default(cuid())
  topic         String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime?
  lastError     String?
  dedupKey      String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  processedAt   DateTime?

  @@index([status, nextAttemptAt])
}

model PaymentEvent {
  id                        String                    @id @default(cuid())
  provider                  PaymentProvider
  source                    PaymentEventSource
  transmissionId            String?
  eventType                 String
  verifiedMode              PaymentMode?
  verifiedCredentialBinding String?
  checkoutSessionId         String?
  providerPaymentKey        String?
  raw                       Json
  status                    PaymentEventStatus        @default(RECEIVED)
  receivedAt                DateTime                  @default(now())
  processedAt               DateTime?
  attemptCount              Int                       @default(0)
  lastAttemptAt             DateTime?
  failureStage              PaymentEventFailureStage?
  failureCode               String?
  lastError                 String?

  @@unique([provider, transmissionId])
  @@index([checkoutSessionId])
}

model WebhookIngressRejection {
  id                      String                       @id @default(cuid())
  provider                PaymentProvider
  stage                   WebhookIngressRejectionStage
  code                    String
  candidateTransmissionId String?
  candidateEventType      String?
  rawBodyBytes            Int
  rawBodyHash             String?
  rawBodyPrefix           String?                      @db.Text
  lastError               String?
  receivedAt              DateTime                     @default(now())
  createdAt               DateTime                     @default(now())

  @@index([provider, receivedAt])
  @@index([candidateTransmissionId])
}

// ============================================================
// 리뷰 (자리만, UI는 2차)
// ============================================================

model Review {
  id         String   @id @default(cuid())
  userId     String
  wigStyleId String
  rating     Int
  body       String?  @db.Text
  imageKeys  String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  style WigStyle @relation(fields: [wigStyleId], references: [id])

  @@unique([userId, wigStyleId])
}
