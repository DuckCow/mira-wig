output "bootstrap_manifest" {
  description = "Nonsecret exact dormant bootstrap runtime handoff."
  value = {
    contract_version                = local.contract.contractVersion
    source_commit                   = local.job_source_commit
    source_tree                     = local.contract.image.sourceTree
    context_sha256                  = local.contract.image.contextSha256
    context_files                   = local.contract.image.contextFiles
    backend_prefix                  = local.backend_prefix
    project_id                      = var.project_id
    region                          = local.region
    service_account_email           = google_service_account.bootstrap.email
    iam_database_username           = google_sql_user.bootstrap.name
    cloud_sql_instance_name         = local.cloud_sql_instance_name
    database_name                   = local.database_name
    image_digest_uri                = local.job_image_digest_uri
    job_name                        = google_cloud_run_v2_job.bootstrap.name
    default_mode                    = "check"
    selected_mode                   = var.bootstrap_mode
    allowed_modes                   = local.contract.job.terraformModeSelector.allowedModes
    explicit_mutating_mode          = "apply"
    grant_only_mode                 = "apply-canary-role-grants"
    contacted_reconciliation_grant  = "apply-contacted-reconciliation-role-grants"
    business_state_readback_grant   = "apply-business-state-readback-role-grants"
    business_state_readback_revoke  = "revoke-business-state-readback-role-grants"
    canonical_refund_grants_restore = "restore-canary-refund-role-grants"
    credential_materialization_mode = "materialize-application-credentials"
    credential_recovery_mode        = "recover-canary-application-credential"
    task_count                      = 1
    parallelism                     = 1
    max_retries                     = 0
    automatic_trigger               = "NONE"
    network_tags                    = local.network_tags
    egress                          = "ALL_TRAFFIC"
    migration_count                 = local.migration_count
    migration_sha256                = local.migration_sha256
    refund_runtime_version          = local.contract.image.refundAuthority.runtimeContractVersion
    refund_runtime_sha256           = local.contract.image.refundAuthority.runtimeContractSha256
    refund_image_policy_version     = local.contract.image.refundAuthority.imagePolicyVersion
    refund_image_policy_sha256      = local.contract.image.refundAuthority.imagePolicySha256
    refund_worker_manifest_digest   = local.contract.image.refundAuthority.workerManifestDigest
    refund_worker_config_digest     = local.contract.image.refundAuthority.workerConfigDigest
    producer_result_field           = local.contract.image.producerResultBoundary.field
    producer_result_stdout_limit    = local.contract.image.producerResultBoundary.stdoutByteLimit
    producer_result_cleanup_failure = local.contract.image.producerResultBoundary.cleanupFailurePreservation
    producer_input_owner            = local.contract.job.producerInputForwarding.owner
    producer_target_input_names     = local.contract.job.producerInputForwarding.materializeTarget
    producer_approval_input_names   = local.contract.job.producerInputForwarding.issueApproval
    provider_credentials            = "NONE"
    temporary_cloud_sql_access      = var.temporary_cloud_sql_access_authorized
    cloud_sql_login_authority       = var.temporary_cloud_sql_access_authorized ? "EXACT_TWO_CONDITIONED_BINDINGS" : "NONE"
    credential_secret_iam_authority = "NONE"
    secret_manager_dependencies     = "NO_STANDING_AUTHORITY_IMAGE_CAPABILITY_RETAINED"
    future_migration_reentry        = "SEPARATELY_AUTHORIZED_DEFAULT_FALSE_INPUT_TRUE_REQUIRED"
    execution_status                = "RETAINED_DORMANT_NO_AUTOMATIC_TRIGGER"
  }
}
