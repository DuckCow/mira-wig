# ============================================================
# .env.example
# 실제 값은 .env 에 넣고, .env 는 절대 커밋하지 않는다.
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/wig_platform?schema=public"

# --- NextAuth ---
NEXTAUTH_SECRET="여기에-랜덤-시크릿-생성해-넣기 (openssl rand -base64 32)"
NEXTAUTH_URL="http://localhost:3000"

# --- AWS S3 (스토리지 추상화 계층) ---
AWS_REGION="ap-northeast-2"
AWS_S3_BUCKET="your-bucket-name"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- AI 가상 피팅 (추상화 계층) ---
# mock = MockFittingProvider (기본) | real = 외부 AI API
AI_PROVIDER="mock"

# --- 스토리지 공급자 ---
# mock = MockStorageProvider (AWS 불필요, 로컬 개발용)
# 설정 안 함 = S3StorageProvider (AWS_REGION / AWS_S3_BUCKET 필수)
STORAGE_PROVIDER="mock"

# --- 토스페이먼츠 (결제 추상화 계층) ---
# 비어 있으면 모든 마켓 MockPaymentProvider 사용. KR 입력 시 KR만 TossPaymentProvider 사용.
PAYMENT_LIVE_MARKETS=""
# API 개별 연동 클라이언트 키. 브라우저 결제창 SDK에는 NEXT_PUBLIC_ 값을 사용한다.
TOSS_CLIENT_KEY=""
# 클라이언트 키는 NEXT_PUBLIC_ 접두사로 브라우저에 노출 가능
NEXT_PUBLIC_TOSS_CLIENT_KEY=""
# 시크릿 키는 서버에서만 사용 — 절대 클라이언트에 노출 금지
TOSS_SECRET_KEY=""

# --- 결제 Mock 제어 ---
# 1 = MockPaymentProvider가 항상 실패를 반환 (개발·QA용)
# 설정 안 함 또는 0 = 항상 성공
PAYMENT_MOCK_FORCE_FAIL=""
