# ============================================================
# .env.example
# 실제 값은 .env 에 넣고, .env 는 절대 커밋하지 않는다.
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/wig_platform?schema=public"

# --- DEMO-ONLY destructive catalog seed guard ---
# Leave both blank during ordinary development. Explicit `prisma db seed` replaces
# commerce/catalog rows only when the expected database name matches DATABASE_URL
# and PostgreSQL current_database()/current_user/current_schema(). An omitted schema is
# canonicalized to the only supported namespace, `public`; any other schema is
# rejected. The acknowledgement binds the normalized, password-free target
# `postgresql://username@host:effective-port/database?schema=public`.
# The admitted fields, not the raw URL or ambient PG* target defaults, are passed
# explicitly to PrismaPg/pg:
# DEMO_ONLY_ERASE_AND_REPLACE_TARGET:<normalized-target>
MIRA_DEMO_SEED_EXPECTED_DATABASE=""
MIRA_DEMO_SEED_ACKNOWLEDGEMENT=""

# --- NextAuth ---
NEXTAUTH_SECRET="여기에-랜덤-시크릿-생성해-넣기 (openssl rand -base64 32)"
NEXTAUTH_URL="http://localhost:3000"

# --- AWS S3 (스토리지 추상화 계층) ---
AWS_REGION="ap-northeast-2"
AWS_S3_BUCKET="your-bucket-name"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- AI 가상 피팅 (추상화 계층) ---
# mock = MockFittingProvider (기본) | real = 외부 AI API
AI_PROVIDER="mock"

# --- 스토리지 공급자 ---
# mock = MockStorageProvider (AWS 불필요, 로컬 개발용)
# 설정 안 함 = S3StorageProvider (AWS_REGION / AWS_S3_BUCKET 필수)
STORAGE_PROVIDER="mock"

# GeoIP headers are ignored unless the deployment ingress is explicitly trusted.
# Allowed values: none (default), vercel, cloudflare.
MIRA_GEOIP_TRUST_MODE="none"

# --- 결제 모드 / 라이브 게이트 ---
# PAYMENT_MODE 미설정/빈 값 = SANDBOX. 유효값: SANDBOX | LIVE (대소문자 정확히 일치).
# LIVE는 real provider adapters + registry liveEnabled allowlist + credential/live guard가 모두 준비된 뒤에만 사용한다.
PAYMENT_MODE=""
# Legacy: 신 결제 코어는 이 값을 읽지 않는다. live 전환은 PAYMENT_MODE + registry liveEnabled 정책으로만 진행한다.
PAYMENT_LIVE_MARKETS=""

# --- 토스페이먼츠 (결제 추상화 계층) ---
# 브라우저 결제창 SDK 클라이언트 키. 이 Patch 1 action-adapter credential gate와는 별도다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=""
# Toss SANDBOX/test server API secret key. 실제 값은 절대 커밋하지 않는다.
TOSS_SANDBOX_SECRET_KEY=""
# Toss 환불의 비밀이 아닌 SANDBOX merchant/credential-generation binding 표식.
# 이 값들은 lookup, 환불 승인, provider contact, 또는 어떤 기능 활성화도 켜지 않는다.
TOSS_SANDBOX_MERCHANT_ACCOUNT_BINDING=""
TOSS_SANDBOX_CREDENTIAL_GENERATION_BINDING=""
# Every Toss secret rotation must also rotate TOSS_SANDBOX_CREDENTIAL_GENERATION_BINDING.
# Toss SANDBOX 외부 provider 호출 opt-in. action/confirm은 미설정/빈 값이면 mock 유지.
# 공개 webhook은 mock으로 폴백하지 않으며, PAYMENT_MODE=SANDBOX + 정확히 ENABLED +
# credential + reviewed code-registry entry가 모두 있어야 query verification이 활성화된다.
# 이 키만 있거나 credential만 있어서는 외부 호출이 켜지지 않는다.
TOSS_SANDBOX_EXTERNAL_ENABLED=""
# Toss LIVE server API secret key. live adapter + liveEnabled + go-live 작업 전에는 사용하지 않는다.
TOSS_LIVE_SECRET_KEY=""

# --- PayPal (결제 추상화 계층) ---
# sandbox | live. 미설정 시 sandbox.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
PAYPAL_WEBHOOK_ID=""

# --- Payment mock behavior ---
# Blank/unset or success = normal mock success.
# amount-mismatch = return an incorrect confirmed amount for validation testing.
# retryable-throw = simulate a retryable provider failure.
# Non-production QA/testing only. Does not enable an external provider.
PAYMENT_MOCK_MODE=""

# --- Customer refund intake dormant activation gates ---
# Unset/blank = disabled; exact ENABLED = enabled; any other nonblank value is invalid configuration.
# PAYMENT_MODE/SANDBOX does not enable these capabilities.
# Customer submission requires legal/product approval before production enablement.
# Do not enable a gated action before its corresponding read/UI recovery surface is deployed.
CUSTOMER_REFUND_INTAKE_SUBMIT_ENABLED=
CUSTOMER_REFUND_INTAKE_APPROVE_ENABLED=
CUSTOMER_REFUND_INTAKE_EXIMBAY_APPROVE_ENABLED=

# --- Manual KR item-relation purpose gates ---
# Default off and purpose-specific. These keys do not create relation data.
# They do not authorize automatic recommendation, D5/D6, events, learning,
# personalization, or commerce claims. Enabling requires a separately recorded
# KR activation decision.
MANUAL_ITEM_RELATIONS_KR_SIMILAR_STYLE_ENABLED=
MANUAL_ITEM_RELATIONS_KR_COMPARE_WITH_ENABLED=

# --- Refund execution claim dormant activation gate ---
# Unset/blank = disabled; exact ENABLED = enabled; any other nonblank value is invalid configuration.
# PAYMENT_MODE or SANDBOX mode does not itself activate this capability.
# This gate authorizes an administrator to enter the reviewed claim boundary.
# EXIMBAY additionally requires its provider-specific claim gate below.
# Neither gate enables worker routing, dispatch, or provider calls.
REFUND_EXECUTION_CLAIM_ENABLED=
REFUND_EXECUTION_EXIMBAY_CLAIM_ENABLED=

# --- Refund exact-command lease dormant activation gate ---
# Disabled by default. Enables only exact-command lease acquisition.
# Does not enable discovery, a worker, provider dispatch, or result application.
REFUND_EXECUTION_LEASE_ENABLED=

# --- Refund exact-current pre-contact lease-release dormant activation gate ---
# Disabled by default. Enables only exact-current-fence, ordinal-zero, pre-contact lease release.
# Does not enable expired reclaim, renewal, worker/discovery, provider dispatch, or result application.
REFUND_EXECUTION_LEASE_RELEASE_ENABLED=

# --- Refund expired ordinal-zero uncontacted-recovery dormant activation gate ---
# Disabled by default. Repairs only expired ordinal-zero leases; it does not enable
# new ordinary work, authorize provider GET or POST, or create a worker or scheduler.
# It does not deploy migrations or activate LIVE use.
REFUND_EXECUTION_UNCONTACTED_RECOVERY_ENABLED=

# --- Dormant host-neutral refund-execution worker gate ---
# Enables only dormant command selection and invocation routing. It does not
# authorize REQUESTED intake or independently authorize leasing, reclaim,
# provider lookup/contact, result application, recontact, migrations,
# scheduling, production startup, or LIVE use.
REFUND_EXECUTION_WORKER_ENABLED=

# --- Refund dormant MOCK/SANDBOX first-dispatch authorization gate ---
# Disabled by default. Enables only exact-current-fence authorization of ordinal 1.
# Does not enable provider contact/invocation, result application, worker/discovery,
# or positive-ordinal retry.
REFUND_EXECUTION_DISPATCH_AUTHORIZATION_ENABLED=
# Disabled by default. These gates authorize only dormant Toss eligibility lookup
# and ordinal-1 authorization; neither enables cancellation contact or activation.
REFUND_EXECUTION_TOSS_AUTHORIZATION_ENABLED=
REFUND_EXECUTION_TOSS_ELIGIBILITY_LOOKUP_ENABLED=
# Dormant initial Toss contact gate only. This does not activate a worker, deploy
# migrations, authorize recovery, or by itself create a production caller.
REFUND_EXECUTION_TOSS_CONTACT_ENABLED=
REFUND_EXECUTION_OBSERVATION_APPLICATION_ENABLED=
# ENABLED permits only fresh, fully fenced refund observation/result application.
# It does not enable provider contact/invocation, workers/discovery, reconciliation,
# or reclaim/retry authorization.

# --- Dormant contacted Toss recovery lookup gate ---
# Disabled by default. This gate does not create a worker or production caller,
# deploy migrations, or authorize a recontact POST.
REFUND_EXECUTION_TOSS_RECOVERY_LOOKUP_ENABLED=
REFUND_EXECUTION_TOSS_RECOVERY_RECONTACT_ENABLED=
# Dormant ordinal-2 recovery contact only. This does not create a worker,
# deploy migrations, create a production caller, authorize retry loops,
# or activate LIVE use.
# Eximbay EX2B2-S2 dormant server configuration.
# Presence does not enable EXIMBAY routing or authorize provider contact.
EXIMBAY_SANDBOX_API_KEY=
EXIMBAY_SANDBOX_MID=
EXIMBAY_LIVE_API_KEY=
EXIMBAY_LIVE_MID=
# Default/empty disables customer checkout. Exact ENABLED opts in only the
# bounded Eximbay SANDBOX checkout path; LIVE and BF4 callback authority remain separate.
EXIMBAY_CHECKOUT_SANDBOX_ENABLED=
# Dormant SANDBOX status_url route only. Unset/blank = disabled; exact ENABLED = enabled.
# Keep blank until separately authorized sandbox transport evidence. This does not enable
# EXIMBAY checkout routing, SDK/request_pay, E2, provider LIVE use, or any LIVE callback.
EXIMBAY_BF4_STATUS_ROUTE_ENABLED=
PAYMENT_PUBLIC_ORIGIN=
